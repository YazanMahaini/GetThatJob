digraph GetThatJob {
  graph [rankdir=TB,bgcolor="#111111",pad=0.5,nodesep=0.45,ranksep=0.85,splines=polyline,outputorder=edgesfirst];
  node [shape=box,style="rounded,filled",fillcolor="#00182f",color="#355675",penwidth=2,fontname="Arial",fontsize=19,fontcolor="#d9e8f6",margin="0.22,0.18"];
  edge [color="#6f95b5",fontcolor="#70b5f3",fontname="Arial",fontsize=15,penwidth=2,arrowsize=0.8];
  start [label="Ask GetThatJob for help"];
  first [label="First use in this workspace?",style="rounded,dashed,filled",fillcolor="#111111",color="#70b5f3"];
  setup [label="SetupSkill creates missing folders\nand blank tracking files"];
  check [label="SetupChecker checks what is available"];
  ready [label="CV and search priorities ready?",style="rounded,dashed,filled",fillcolor="#111111",color="#70b5f3"];
  add [label="You add documents or answer\nkey questions"];
  intake [label="ProfileIntake records verified facts\nand follows your document style"];
  search [label="JobFinder searches LinkedIn Jobs\nand employer sites; checks eligibility"];
  signin [label="If signed out, you sign in to LinkedIn\nthrough its official flow"];
  packet [label="Create a tailored CV, cover letter\nand application packet"];
  draft [label="Fill and check a portal draft\nwhen accessible"];
  outside [label="A checked application filled\noutside JobFinder"];
  profile [label="ProfileBuilder merges verified\nreusable answers into the private profile"];
  review [label="You review the application",style="rounded,dashed,filled",fillcolor="#111111",color="#70b5f3"];
  selfsubmit [label="You submit the application"];
  finalize [label="ApplicationFinalize checks and submits\nonly with your direction"];
  confirm [label="EmailConfirmationChecker checks\nfor a matching receipt"];
  tracker [label="Tracker and packet record\nthe verified outcome"];
  followup [label="ApplicationFollowUp checks\nlater status when requested"];
  start -> first [];
  first -> setup [label="Yes"];
  first -> check [label="No"];
  setup -> check [];
  check -> ready [];
  ready -> add [label="No"];
  add -> intake [];
  intake -> check [constraint=false];
  ready -> search [label="Yes"];
  search -> signin [label="Signed out",constraint=false];
  signin -> search [label="Resume",constraint=false];
  search -> packet [];
  packet -> draft [];
  draft -> profile [];
  outside -> profile [];
  profile -> review [];
  review -> packet [label="Revisions",constraint=false];
  review -> selfsubmit [label="You submit"];
  review -> finalize [label="Ask it to submit"];
  selfsubmit -> confirm [];
  finalize -> confirm [];
  confirm -> tracker [];
  tracker -> followup [label="Later update"];
  followup -> tracker [constraint=false];
  tracker -> search [label="Next role reuses confirmed answers",constraint=false,style=dashed];
}